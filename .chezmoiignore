# Ignore patterns for `chezmoi`

# gitignore
.gitignore

# python
**/__pycache__

# Repository specific files
chezmoi.toml
README.md
LICENSE
assets/
justfile
temp.py
docs/
.env
CLAUDE.md
REVIEW.md
# Symlink to CLAUDE.md; without this chezmoi follows it and deploys the
# repo guide to ~/AGENTS.md, where Codex/OpenCode read it as global rules.
AGENTS.md
pkgs/
misc/
tools/

# Editconfig
.editorconfig

# Makefile
Makefile

# Fetched-skill runtimes: cloned by `agent-skills.sh fetch`, deliberately not
# vendored. Only the symlink in .agents/skills is managed. Without this a
# `chezmoi add ~/.agents` would pull tens of MB of upstream trees into the repo.
.agents/runtimes/

# bin
bin/
# sketchybar helpers compile C sources into nested bin/ dirs. The pattern
# above only matches the top-level bin. Do not broaden this to **/bin/:
# that would also match .local/bin and unmanage the scripts in it.
.config/sketchybar/helpers/**/bin/

# Platform-specific: Linux-only configs (ignore on macOS)
{{- if eq .chezmoi.os "darwin" }}
.config/systemd
.config/niri
.config/noctalia
.config/hypr
.config/waybar
.config/swaync
.config/wofi
.config/walker
.config/wlr-which-key
.config/ulauncher
.config/fontconfig
{{- end }}

# Platform-specific: macOS-only configs (ignore on Linux)
{{- if eq .chezmoi.os "linux" }}
Library
.config/karabiner
.aerospace.toml
.config/omniwm
.config/sketchybar
.zprofile
{{- end }}

# The Hindsight memory server runs on macmini only; other hosts are clients.
{{- if ne .chezmoi.hostname "Dileeps-Mac-mini" }}
Library/LaunchAgents/com.dkishore.hindsight-api.plist
.chezmoiscripts/55_hindsight-server.sh
{{- end }}

# Hindsight's staged runtime, logs and companion skill copies are written by
# its client, not chezmoi; keep `chezmoi add ~/.agents` from vendoring them.
.hindsight/coding-agents
.hindsight/coding-agents-logs
.hindsight/state
.agents/skills/hindsight-coding-agent
.claude/skills/hindsight-coding-agent
# NERSC is not a Hindsight client.
{{- if eq .chezmoi.homeDir "/global/homes/d/dkishore" }}
.hindsight
.chezmoiscripts/60_hindsight-client.sh
{{- end }}

# The pixi global manifest is a copy of NERSC's, fetched by sync_manifest.sh;
# no other host runs pixi global. Same NERSC check as dot_zshrc.tmpl.
{{- if ne .chezmoi.homeDir "/global/homes/d/dkishore" }}
.pixi/manifests
{{- end }}

# misc
tests/
.config/sesh/sesh.toml
