# Shared environment for interactive shells and agent shells.

export EDITOR=nvim
export USE_EDITOR=$EDITOR
export VISUAL=$EDITOR
{{- if eq .chezmoi.hostname "tsuki" }}
export BROWSER=helium-browser
{{- end }}
export GIT_PAGER="delta"
export FZF_DEFAULT_OPTS="\
    --height 40% --reverse --preview 'bat --style=numbers --color=always --line-range :100 {}'\
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
    --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

export PATH=$PATH:$HOME/.local/bin
export PATH="$PATH:/var/lib/flatpak/exports/bin"
export PATH="$PATH:$HOME/npm-global/bin"
export PATH="$HOME/.pixi/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
{{- if eq .chezmoi.os "darwin" }}
export PATH="$(brew --prefix rustup)/bin:$PATH"
{{- end }}
export PATH="$HOME/.cargo/bin:$PATH"

# API keys. Source of truth is the age-encrypted
# private_dot_config/encrypted_private_secrets.env.age in the chezmoi repo;
# `chezmoi apply` decrypts it here. Add a key with:
#   chezmoi edit ~/.config/secrets.env --apply
if [ -f "$HOME/.config/secrets.env" ]; then
    set -a
    . "$HOME/.config/secrets.env"
    set +a
fi

# Codex (CBORG)
## export OPENAI_API_KEY=$CBORG_API_KEY
## export OPENAI_BASE_URL=https://api.cborg.lbl.gov

# Claude and other agent defaults
export ENABLE_LSP_TOOL=1
export DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
export DISABLE_TELEMETRY=1
# export CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192

# Corporate TLS interception (work macOS): export Keychain -> PEM,
# then point every tool at it. No single env var covers all runtimes.
if [[ $(hostname) == "mac148593" ]]; then
  CERT_FILE="$HOME/.config/corporate-certs.pem"

  # Refresh weekly or if missing; combines user+system+system-root keychains
  if [[ ! -f "$CERT_FILE" ]] || [[ -n $(find "$CERT_FILE" -mtime +7 2>/dev/null) ]]; then
    mkdir -p "$(dirname "$CERT_FILE")"
    {
      security find-certificate -a -p /Library/Keychains/System.keychain
      security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain
    } > "$CERT_FILE" 2>/dev/null

  fi

  if [[ -f "$CERT_FILE" ]]; then
    # OpenSSL / curl / rustls-native-certs / uv / git / cargo / aws
    export SSL_CERT_FILE="$CERT_FILE"
    export CURL_CA_BUNDLE="$CERT_FILE"
    export GIT_SSL_CAINFO="$CERT_FILE"
    export CARGO_HTTP_CAINFO="$CERT_FILE"
    export AWS_CA_BUNDLE="$CERT_FILE"

    # Python (pip, requests, httpx)
    export REQUESTS_CA_BUNDLE="$CERT_FILE"
    export PIP_CERT="$CERT_FILE"

    # Node.js + npm (classic CA bundle path)
    export NODE_EXTRA_CA_CERTS="$CERT_FILE"
    # Node 22+ / Bun: read Keychain directly (fixes Bun-based Claude Code)
    export NODE_USE_SYSTEM_CA=1

    # uv: use OS trust store via rustls-platform-verifier
    export UV_SYSTEM_CERTS=true

    # GUI apps launched from Dock don't inherit shell env; launchctl setenv
    # covers this session. For permanent coverage add a LaunchAgent.
    if command -v launchctl >/dev/null 2>&1; then
      launchctl setenv SSL_CERT_FILE "$CERT_FILE" 2>/dev/null
      launchctl setenv NODE_EXTRA_CA_CERTS "$CERT_FILE" 2>/dev/null
      launchctl setenv NODE_USE_SYSTEM_CA 1 2>/dev/null
    fi
  fi
fi
