{{- /* chezmoi:modify-template */ -}}
{{ default "{}" .chezmoi.stdin | fromJson
  | setValueAtPath "defaultProvider" "openai-codex"
  | setValueAtPath "defaultModel" "gpt-5.6-sol"
  | setValueAtPath "defaultThinkingLevel" "high"
  | setValueAtPath "theme" "catppuccin-mocha"
  | setValueAtPath "collapseChangelog" true
  | setValueAtPath "autocompleteMaxVisible" 8
  | setValueAtPath "enabledModels" (list
      "openai-codex/gpt-5.6-sol"
      "openai-codex/gpt-5.5"
      "openai-codex/gpt-5.4"
      "openai-codex/gpt-5.4-mini"
      "openai-codex/gpt-5.3-codex-spark"
    )
  | setValueAtPath "packages" (list
      "npm:pi-subagents@0.88.0"
      "npm:pi-lens@4.4.12"
      "npm:pi-web-search@1.7.0"
      "npm:@juicesharp/rpiv-ask-user-question@2.15.0"
      "npm:@juicesharp/rpiv-todo@2.15.0"
    )
  | toPrettyJson }}
