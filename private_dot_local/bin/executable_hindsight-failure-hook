#!/usr/bin/env python3
"""Send failed shell commands to the Hindsight memory server.

Hindsight's own hooks drop command output before extraction, so a failure is
otherwise remembered only when someone describes it in words. Usage, as an
agent hook reading the event JSON on stdin:

    hindsight-failure-hook claude   # PostToolUseFailure, one failure per call
    hindsight-failure-hook codex    # Stop: scans the session log for new failures

Reads apiUrl, apiToken and retainTags from ~/.hindsight/coding-agent.json and
writes into the same per-repository bank as Hindsight. Never prints to stdout
and always exits 0, so it cannot block or steer an agent.
"""

import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".hindsight" / "coding-agent.json"
STATE = HOME / ".hindsight" / "state" / "failure-hook"
LOG = HOME / ".hindsight" / "coding-agents-logs" / "failure-hook.log"
MAX_ERROR = 1500
TIMEOUT = 3

# Exit status 1 from these means "no match" or "false", not a failure.
QUIET_COMMANDS = ("grep", "rg", "test", "[", "diff", "cmp", "pgrep", "which", "command", "git diff")
SECRET = re.compile(
    r"(sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[abpr]-[A-Za-z0-9-]{10,}"
    r"|(?i:bearer)\s+[A-Za-z0-9._~+/=-]{16,}"
    r"|(?i:(?:password|passwd|secret|token|api[_-]?key))\s*[=:]\s*\S+)"
)


def log(msg):
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as fh:
            fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {msg}\n")
    except OSError:
        pass


def mask(text):
    return SECRET.sub("[redacted]", text)


def repo_name(cwd):
    """The basename Hindsight uses for {gitProject}: the main checkout, so worktrees share it."""
    try:
        out = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=2,
        )
        common = out.stdout.strip()
        if out.returncode == 0 and common:
            common = common.rstrip("/")
            root = os.path.dirname(common) if os.path.basename(common) == ".git" else common
            name = os.path.basename(root)
            return name[:-4] if name.endswith(".git") else name
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.basename(os.path.normpath(cwd)) or "unknown"


def is_noise(command, exit_code, error):
    first = command.strip().split()[0] if command.strip() else ""
    if exit_code == 1 and (not error.strip() or first in QUIET_COMMANDS or command.strip().startswith("git diff")):
        return True
    return exit_code in (130, 143)  # interrupted or terminated by the user


def retain(cfg, failure, harness):
    host_tags = [t for t in cfg.get("retainTags", []) if isinstance(t, str)]
    host = next((t.split(":", 1)[1] for t in host_tags if t.startswith("host:")), "unknown")
    repo = repo_name(failure["cwd"])
    error = mask(failure["error"].strip())[:MAX_ERROR]
    command = mask(failure["command"].strip())
    first_line = error.splitlines()[0] if error else ""
    doc_id = "failure:" + hashlib.sha1(f"{repo}\0{command}\0{first_line}".encode()).hexdigest()[:16]
    content = (
        f"Shell command failed on {host} in repository {repo}: `{command}` "
        f"exited with code {failure['exit_code']}.\nError output:\n{error or '(none)'}"
    )
    item = {
        "content": content,
        "context": (
            f"Automatic record of a failed shell command from {harness} on {host}. "
            "Record the command, the error and its likely cause. It is not a fix; "
            "a later conversation may say what worked instead."
        ),
        "document_id": doc_id,
        "tags": host_tags + ["source:failure-hook"],
        "metadata": {"host": host, "repo": repo, "harness": harness, "exit_code": str(failure["exit_code"])},
        "observation_scopes": [[]],
    }
    bank = urllib.parse.quote(f"coding-agent::{repo}", safe="")
    url = cfg["apiUrl"].rstrip("/") + f"/v1/default/banks/{bank}/memories"
    headers = {"Content-Type": "application/json"}
    if cfg.get("apiToken"):
        headers["Authorization"] = f"Bearer {cfg['apiToken']}"
    req = urllib.request.Request(url, data=json.dumps({"items": [item], "async": True}).encode(), headers=headers)
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        resp.read()
    log(f"retained {doc_id} bank={repo} exit={failure['exit_code']}")


def claude_failures(event):
    if event.get("hook_event_name") != "PostToolUseFailure" or event.get("tool_name") != "Bash":
        return []
    if event.get("is_interrupt"):
        return []
    error = str(event.get("error") or "")
    match = re.match(r"Exit code (\d+)", error)
    exit_code = int(match.group(1)) if match else 1
    if match:
        error = error[match.end():].lstrip("\n")
    command = str((event.get("tool_input") or {}).get("command") or "")
    return [{"command": command, "exit_code": exit_code, "error": error, "cwd": event.get("cwd") or os.getcwd()}]


def codex_failures(event):
    path = event.get("transcript_path")
    session = str(event.get("session_id") or "unknown")
    if not path or not os.path.exists(path):
        return []
    STATE.mkdir(parents=True, exist_ok=True)
    state_file = STATE / f"codex-{re.sub(r'[^A-Za-z0-9_-]', '_', session)}.json"
    try:
        seen = set(json.loads(state_file.read_text()))
    except (OSError, ValueError):
        seen = set()
    failures, new_ids = [], []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            if '"CommandExecution"' not in line:
                continue
            try:
                payload = json.loads(line).get("payload") or {}
            except ValueError:
                continue
            item = payload.get("item") or {}
            if payload.get("type") != "item_completed" or item.get("type") != "CommandExecution":
                continue
            item_id = str(item.get("id") or "")
            exit_code = item.get("exit_code")
            if item_id in seen or item.get("status") != "failed" and exit_code in (0, None):
                continue
            new_ids.append(item_id)
            argv = item.get("command") or []
            command = argv[-1] if isinstance(argv, list) and argv else str(argv)
            cwd = str(item.get("cwd") or event.get("cwd") or os.getcwd())
            if cwd.startswith("file://"):
                cwd = urllib.parse.unquote(urllib.parse.urlparse(cwd).path)
            failures.append({
                "command": command,
                "exit_code": exit_code if exit_code is not None else 1,
                "error": str(item.get("aggregated_output") or ""),
                "cwd": cwd,
            })
    if new_ids:
        state_file.write_text(json.dumps(sorted(seen | set(new_ids))))
    return failures


def main():
    harness = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        event = json.loads(sys.stdin.read() or "{}")
        cfg = json.loads(CONFIG.read_text())
        if cfg.get("serverMode") != "self-hosted" or not cfg.get("apiUrl"):
            return
        found = claude_failures(event) if harness == "claude" else codex_failures(event) if harness == "codex" else []
        for failure in found:
            if not is_noise(failure["command"], failure["exit_code"], failure["error"]):
                retain(cfg, failure, harness)
    except Exception as exc:  # a hook must never fail the agent's turn
        log(f"{harness}: {type(exc).__name__}: {exc}")


if __name__ == "__main__":
    main()
    sys.exit(0)
