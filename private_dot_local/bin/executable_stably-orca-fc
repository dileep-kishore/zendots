#!/usr/bin/env bash
# Launch Orca with a private fontconfig cache.
#
# Orca's Electron bundles fontconfig 2.17.1 while the system runs 2.18.2. The
# bundled one refuses to regenerate caches once it sees any written by a newer
# version, so fonts installed after the system upgrade are invisible to it,
# Monaspace Mixed included. A cachedir of its own gives it a clean slate.
#
# The directory must exist before launch: fontconfig skips a cachedir it cannot
# resolve and silently falls back to the shared ones. Never point system
# fontconfig tools at this config, since that repopulates the cache in the
# newer format and recreates the problem.
#
# Drop this wrapper, ~/.config/fontconfig/orca.conf and the .desktop override
# once Orca ships fontconfig 2.18.1 or newer.
set -euo pipefail

mkdir -p "$HOME/.cache/fontconfig-orca"
export FONTCONFIG_FILE="$HOME/.config/fontconfig/orca.conf"
exec stably-orca "$@"
