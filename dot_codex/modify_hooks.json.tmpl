#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# ///
# Preserve live third-party registrations, drop Orca's, and add our command
# guard and Hindsight memory hooks.
import copy
import json
import sys


def die(msg):
    print("modify hooks.json: " + msg, file=sys.stderr)
    sys.exit(1)


{{ template "agent-command-guard.py" . }}

{{ template "hindsight-hooks.py" . }}

HINDSIGHT_CLIENT = {{ if eq (includeTemplate "hindsight-client" .) "true" }}True{{ else }}False{{ end }}
# The env pins the endpoint, so a missing config file cannot fall back to
# Hindsight Cloud; the config file still wins when present.
HINDSIGHT_ENV = "HINDSIGHT_SERVER_MODE=self-hosted HINDSIGHT_API_URL={{ includeTemplate "hindsight-api-url" . }}"
NODE = {{ or (lookPath "node") "node" | quote }}
HINDSIGHT_DIST = {{ joinPath .chezmoi.homeDir ".hindsight/coding-agents/dist" | quote }}
FAILURE_HOOK = {{ joinPath .chezmoi.homeDir ".local/bin/hindsight-failure-hook" | quote }}


def _hindsight_entry(command, timeout):
    return {"hooks": [{"type": "command", "command": command, "timeout": timeout}]}


# Codex hook payloads carry no exit status, so the failure hook scans the
# session log at Stop instead of reacting per command.
HINDSIGHT_HOOKS = {
    "SessionStart": [_hindsight_entry(f'{HINDSIGHT_ENV} "{NODE}" "{HINDSIGHT_DIST}/codex-sessionstart-hook.js"', 30)],
    "UserPromptSubmit": [_hindsight_entry(f'{HINDSIGHT_ENV} "{NODE}" "{HINDSIGHT_DIST}/codex-hook.js"', 30)],
    "Stop": [
        _hindsight_entry(f'{HINDSIGHT_ENV} "{NODE}" "{HINDSIGHT_DIST}/codex-stop-hook.js"', 60),
        _hindsight_entry(f'"{FAILURE_HOOK}" codex', 30),
    ],
} if HINDSIGHT_CLIENT else {}

raw = sys.stdin.read()
try:
    doc = json.loads(raw) if raw.strip() else {}
except json.JSONDecodeError:
    die("invalid JSON input")
if not isinstance(doc, dict):
    die("root is not a mapping")
before = copy.deepcopy(doc)
drop_orca_hooks(doc)
merge_command_guard(doc)
merge_hindsight_hooks(doc, HINDSIGHT_HOOKS)
if doc == before:
    sys.stdout.write(raw)
else:
    sys.stdout.write(json.dumps(doc, indent=2, ensure_ascii=False) + "\n")
