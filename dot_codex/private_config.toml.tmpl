{{- /* Codex rewrites this file at runtime (projects.*, hooks.state.*, plugins.*,
       marketplaces.*), so machine-local state is guarded per-OS to stop the
       macOS and Linux boxes from clobbering each other on `chezmoi re-add`.
       Keep the rendered output comment-free: codex strips comments when it
       rewrites, which would otherwise show up as a permanent chezmoi diff. */ -}}
model = "gpt-5.6-sol"
model_reasoning_effort = "high"
plan_mode_reasoning_effort = "high"
service_tier = "default"
{{- if eq .chezmoi.os "darwin" }}
notify = ["/Users/g8k/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient", "turn-ended"]
{{- end }}

[tui]
