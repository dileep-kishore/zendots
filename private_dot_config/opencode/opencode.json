{
	"$schema": "https://opencode.ai/config.json",
	"share": "manual",
	"autoupdate": false,
	"default_agent": "plan",
	"model": "openai/gpt-5.6-sol",
	"plugin": [
		"opencode-pty",
		"@franlol/opencode-md-table-formatter@latest",
		"@mohak34/opencode-notifier@latest",
		"opencode-background-agents",
		"@plannotator/opencode@latest",
		"superpowers@git+https://github.com/obra/superpowers.git",
		"@dietrichgebert/ponytail"
	],
	"permission": {
		"edit": "allow",
		"bash": "allow",
		"webfetch": "allow",
		"external_directory": "ask",
		"skill": {
			"create-skill": "ask",
			"humanizer": "ask",
			"orca-independent-review": "ask"
		},
		"playwright_*": "deny",
		"serena_*": "deny"
	},
	"mcp": {
		"sequential-thinking": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@modelcontextprotocol/server-sequential-thinking"
			],
			"environment": {
				"DISABLE_THOUGHT_LOGGING": "true"
			},
			"enabled": true
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app"
		},
		"playwright": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@playwright/mcp@latest"
			],
			"enabled": true
		},
		"serena": {
			"type": "local",
			"command": [
				"uvx",
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server"
			],
			"enabled": true,
			"timeout": 15000
		}
	},
	"agent": {
		"build": {
			"permission": {
				"playwright_*": "allow",
				"serena_*": "allow"
			}
		},
		"plan": {
			"permission": {
				"serena_*": "allow"
			}
		}
	},
	"provider": {
		"cborg": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "CBorg API",
			"options": {
				"baseURL": "https://api.cborg.lbl.gov",
				"apiKey": "{env:CBORG_API_KEY}"
			},
			"models": {
				"lbl/cborg-coder": {
					"id": "lbl/cborg-coder",
					"name": "CBorg Coder",
					"reasoning": true,
					"tool_call": true,
					"limit": {
						"context": 131072,
						"output": 131072
					}
				},
				"lbl/claude-sonnet-5": {
					"id": "claude-sonnet-5",
					"name": "Claude Sonnet 5",
					"reasoning": true,
					"tool_call": true
				},
				"lbl/claude-opus-5": {
					"id": "claude-opus-5",
					"name": "Claude Opus 5",
					"reasoning": true,
					"tool_call": true,
					"options": {
						"reasoningEffort": "high",
						"textVerbosity": "low"
					}
				},
				"lbl/gpt-5.3-codex": {
					"id": "gpt-5.3-codex",
					"name": "GPT 5.3 codex",
					"reasoning": true,
					"tool_call": true
				},
				"lbl/gemini-3.1-pro": {
					"id": "gemini-3.1-pro",
					"name": "Gemini 3.1 Pro",
					"reasoning": true,
					"tool_call": true,
					"options": {
						"reasoningEffort": "high",
						"textVerbosity": "low"
					}
				}
			}
		}
	}
}
